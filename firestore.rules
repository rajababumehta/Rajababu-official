rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public news and articles published by Rajababu Mehta
    match /public_posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    // Public gallery moments
    match /clipzone_images/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Public reader comments
    match /public_comments/{commentId} {
      allow read, write: if true;
    }

    // System settings
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }
  }
}
