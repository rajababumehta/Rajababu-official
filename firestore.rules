rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'rajababum426@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'rajababum426@gmail.com') ||
        (request.auth.token.email == 'support@rajababumehta.com.np')
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Post validation
    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'content']) &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.content is string && data.content.size() <= 10000 &&
        (!('contentNe' in data) || (data.contentNe is string && data.contentNe.size() <= 10000)) &&
        (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 120)) &&
        (!('authorPhoto' in data) || (data.authorPhoto is string && data.authorPhoto.size() <= 2000)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
        (!('likesCount' in data) || data.likesCount is number) &&
        (!('commentsCount' in data) || data.commentsCount is number) &&
        (!('isPublished' in data) || data.isPublished is bool);
    }

    // Comment validation
    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorName', 'content']) &&
        data.postId is string && data.postId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.content is string && data.content.size() <= 2000;
    }

    // Like validation
    function isValidLike(data) {
      return data.keys().hasAll(['userId']) &&
        data.userId is string && data.userId.size() <= 128;
    }

    // Inquiry validation
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
        data.name is string && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 120 &&
        data.message is string && data.message.size() <= 5000;
    }

    // 1. Posts Collection (Facebook-style feed)
    match /posts/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;

      allow create: if isValidId(postId) && isValidPost(incoming());

      allow update: if isValidId(postId) && (
        (isAdmin() && isValidPost(incoming())) ||
        isValidPost(incoming()) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      );

      allow delete: if isValidId(postId);

      // Subcollection: Comments
      match /comments/{commentId} {
        allow get: if isValidId(commentId);
        allow list: if true;
        allow create: if isValidId(commentId) && isValidComment(incoming());
        allow update, delete: if isValidId(commentId);
      }

      // Subcollection: Likes
      match /likes/{likeId} {
        allow get: if isValidId(likeId);
        allow list: if true;
        allow create: if isValidId(likeId) && isValidLike(incoming());
        allow delete: if isValidId(likeId);
      }
    }

    // Legacy public posts compatibility
    match /public_posts/{postId} {
      allow read, write: if true;
    }

    match /deleted_posts/{postId} {
      allow read, write: if true;
    }

    match /clipzone_images/{imageId} {
      allow read, write: if true;
    }

    match /site_configuration/{docId} {
      allow read, write: if true;
    }

    // 2. Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, update, delete: if true;
    }

    // 3. Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
